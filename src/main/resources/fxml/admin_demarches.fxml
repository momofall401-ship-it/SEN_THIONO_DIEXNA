<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.senthioonodiexna.controller.AdminDemarchesController"
      spacing="20.0" style="-fx-padding: 24px;"
      stylesheets="@../css/style.css">

    <!-- Header & Action -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="4.0">
            <Label text="Gestion du Catalogue des Démarches" styleClass="title-large"/>
            <Label text="Création, édition des conditions, gestion des statuts de publication (RG05) et suppression" styleClass="text-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouvelle Démarche" onAction="#handleNewDemarche" styleClass="btn-primary"/>
    </HBox>

    <!-- Filters Bar -->
    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 18px;">
        <TextField fx:id="searchField" promptText="Recherche par titre..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilterCombo" promptText="Tous les statuts de publication" prefWidth="220.0"/>
        <Button text="Filtrer" onAction="#handleFilter" styleClass="btn-secondary"/>
        <Button text="Réinitialiser" onAction="#handleReset" styleClass="btn-secondary"/>
    </HBox>

    <!-- Démarches Table -->
    <TableView fx:id="demarchesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colTitre" text="Titre de la démarche" prefWidth="240.0"/>
            <TableColumn fx:id="colService" text="Service Compétent" prefWidth="200.0"/>
            <TableColumn fx:id="colFrais" text="Frais" prefWidth="120.0"/>
            <TableColumn fx:id="colDelai" text="Délai Estimé" prefWidth="130.0"/>
            <TableColumn fx:id="colStatutPublication" text="Publication" prefWidth="120.0"/>
            <TableColumn fx:id="colAction" text="Actions" prefWidth="200.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
