<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sn.senthioonodiexna.controller.LoginController"
            prefHeight="680.0" prefWidth="900.0"
            stylesheets="@../css/style.css">

    <!-- Left Brand Panel -->
    <left>
        <VBox alignment="CENTER" prefWidth="380.0" spacing="20.0"
              style="-fx-background-color: #0f172a; -fx-padding: 40px;">
            <VBox spacing="12.0" alignment="CENTER">
                <ImageView fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png"/>
                    </image>
                </ImageView>
                <Label text="SEN THIOONO DIEXNA" textAlignment="CENTER"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                <Label text="Assistant numérique d'accompagnement des démarches administratives"
                       textAlignment="CENTER" wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #d4af37; -fx-font-weight: 600;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.2;"/>

            <VBox spacing="12.0">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Catalogue officiel des démarches sénégalaises" style="-fx-text-fill: #94a3b8;"/>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Checklist interactive des pièces requises" style="-fx-text-fill: #94a3b8;"/>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Suivi en temps réel de votre dossier" style="-fx-text-fill: #94a3b8;"/>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Téléchargement des fiches récapitulatives PDF" style="-fx-text-fill: #94a3b8;"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="République du Sénégal — Travail de groupe 2026" style="-fx-text-fill: #475569; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <!-- Right Login Form -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f8fafc; -fx-padding: 50px;">
            <VBox maxWidth="380.0" spacing="22.0" styleClass="card">
                <VBox spacing="6.0">
                    <Label text="Bienvenue" styleClass="title-large"/>
                    <Label text="Connectez-vous à votre espace personnel" styleClass="text-muted"/>
                </VBox>

                <!-- Form Fields -->
                <VBox spacing="14.0">
                    <VBox spacing="6.0">
                        <Label text="Adresse E-mail" styleClass="text-bold"/>
                        <TextField fx:id="emailField" promptText="exemple@domaine.sn"/>
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Mot de passe" styleClass="text-bold"/>
                        <PasswordField fx:id="passwordField" promptText="••••••••"/>
                    </VBox>

                    <Label fx:id="errorLabel" wrapText="true" visible="false" managed="false"
                           style="-fx-text-fill: #dc3545; -fx-font-size: 12px;"/>

                    <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin"
                            maxWidth="Infinity" styleClass="btn-primary" defaultButton="true"/>
                </VBox>

                <Separator/>

                <!-- Inscription Link -->
                <HBox alignment="CENTER" spacing="8.0">
                    <Label text="Vous n'avez pas encore de compte ?" styleClass="text-muted"/>
                    <Hyperlink text="Créer un compte" onAction="#handleGoToRegister"
                               style="-fx-text-fill: #0f5132; -fx-font-weight: bold; -fx-underline: true;"/>
                </HBox>

                <!-- Demo Credentials Quick Selector -->
                <VBox spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 6px;">
                    <Label text="Comptes de démonstration :" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <HBox spacing="6.0">
                        <Button text="Citoyen" onAction="#fillCitoyen" style="-fx-font-size: 11px; -fx-padding: 4px 8px;"/>
                        <Button text="Agent DPAF" onAction="#fillAgent" style="-fx-font-size: 11px; -fx-padding: 4px 8px;"/>
                        <Button text="Responsable" onAction="#fillResponsable" style="-fx-font-size: 11px; -fx-padding: 4px 8px;"/>
                        <Button text="Admin" onAction="#fillAdmin" style="-fx-font-size: 11px; -fx-padding: 4px 8px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
