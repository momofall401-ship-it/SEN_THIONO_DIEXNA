<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.senthioonodiexna.controller.AdminUsersController"
      spacing="20.0" style="-fx-padding: 24px;"
      stylesheets="@../css/style.css">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="4.0">
            <Label text="Administration des Comptes Utilisateurs" styleClass="title-large"/>
            <Label text="Gestion des rôles (RBAC), affectation aux services administratifs et activation de comptes" styleClass="text-muted"/>
        </VBox>
    </HBox>

    <!-- Search Bar -->
    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12px 18px;">
        <TextField fx:id="searchField" promptText="Recherche par nom, prénom ou e-mail..."
                   HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="roleFilterCombo" promptText="Tous les rôles" prefWidth="180.0"/>
        <Button text="Filtrer" onAction="#handleFilter" styleClass="btn-secondary"/>
        <Button text="Réinitialiser" onAction="#handleReset" styleClass="btn-secondary"/>
    </HBox>

    <!-- Users Table -->
    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="colNomComplet" text="Nom &amp; Prénom" prefWidth="180.0"/>
            <TableColumn fx:id="colEmail" text="Adresse E-mail" prefWidth="200.0"/>
            <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="130.0"/>
            <TableColumn fx:id="colRole" text="Rôle" prefWidth="130.0"/>
            <TableColumn fx:id="colService" text="Service Assigné" prefWidth="190.0"/>
            <TableColumn fx:id="colStatut" text="Statut Compte" prefWidth="120.0"/>
            <TableColumn fx:id="colAction" text="Actions de gestion" prefWidth="180.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
