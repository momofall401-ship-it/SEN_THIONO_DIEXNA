<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sn.senthioonodiexna.controller.MainLayoutController"
            prefHeight="750.0" prefWidth="1200.0"
            stylesheets="@../css/style.css">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar">
            <!-- Brand -->
            <VBox spacing="4.0" styleClass="sidebar-brand">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <ImageView fitHeight="34.0" fitWidth="34.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.png"/>
                        </image>
                    </ImageView>
                    <VBox>
                        <Label text="SEN THIOONO" styleClass="sidebar-title"/>
                        <Label text="DIEXNA" styleClass="sidebar-subtitle"/>
                    </VBox>
                </HBox>
                <Label text="Démarches administratives" style="-fx-text-fill: #64748b; -fx-font-size: 10px;"/>
            </VBox>

            <!-- Nav Links Container -->
            <VBox fx:id="navMenuBox" spacing="4.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="12.0" bottom="12.0"/>
                </padding>
                <!-- Dynamic Navigation Buttons injected or managed by controller -->
            </VBox>

            <!-- Bottom User & Logout -->
            <VBox spacing="6.0" style="-fx-padding: 14px; -fx-border-color: #1e293b transparent transparent transparent;">
                <Button fx:id="profileNavBtn" text="👤  Mon profil" onAction="#handleNavProfile"
                        maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="🚪  Déconnexion" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="nav-button" style="-fx-text-fill: #f87171;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center Main Content -->
    <center>
        <BorderPane>
            <!-- Top Header -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-header">
                    <Label fx:id="pageTitleLabel" text="Tableau de bord" styleClass="title-large"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Notifications Button with Badge -->
                    <HBox alignment="CENTER" spacing="6.0">
                        <Button text="🔔 Notifications" onAction="#handleNavNotifications" styleClass="btn-secondary"/>
                        <Label fx:id="notificationBadge" text="0" styleClass="notification-badge" visible="false" managed="false"/>
                    </HBox>

                    <!-- User Profile Badge -->
                    <HBox alignment="CENTER" spacing="10.0" styleClass="user-badge">
                        <Label text="👤" style="-fx-font-size: 16px;"/>
                        <VBox alignment="CENTER_LEFT">
                            <Label fx:id="userNameLabel" text="Moussa Ba" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <Label fx:id="userRoleLabel" text="Citoyen" style="-fx-text-fill: #0f5132; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                </HBox>
            </top>

            <!-- Dynamic Content Area -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc;"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
