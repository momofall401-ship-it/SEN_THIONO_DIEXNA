<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sn.senthioonodiexna.controller.DashboardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;"
            stylesheets="@../css/style.css">

    <VBox spacing="24.0" style="-fx-padding: 24px;">
        <!-- Header & Scope Filter -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="4.0">
                <Label fx:id="dashboardScopeLabel" text="Tableau de bord décisionnel" styleClass="title-large"/>
                <Label text="Indicateurs de performance, volumétrie et répartition des démarches" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="adminFilterBox" spacing="10.0" alignment="CENTER_RIGHT" visible="false" managed="false">
                <Label text="Service :" styleClass="text-bold"/>
                <ComboBox fx:id="serviceFilterCombo" prefWidth="240.0" promptText="Tous les services (Global)"/>
            </HBox>
        </HBox>

        <!-- KPI Cards Row -->
        <HBox spacing="16.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card-stat">
                <Label text="Total des dossiers" styleClass="text-muted"/>
                <Label fx:id="kpiTotalLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="Toutes demandes confondues" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card-stat">
                <Label text="En cours de traitement" styleClass="text-muted"/>
                <Label fx:id="kpiEnCoursLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                <Label text="Vérification &amp; instruction" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card-stat">
                <Label text="Compléments attendus" styleClass="text-muted"/>
                <Label fx:id="kpiComplementsLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                <Label text="Blocage usager" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card-stat">
                <Label text="Dossiers acceptés" styleClass="text-muted"/>
                <Label fx:id="kpiAcceptesLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                <Label fx:id="tauxAcceptationLabel" text="Taux : 0%" style="-fx-font-size: 11px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS" styleClass="card-stat">
                <Label text="Dossiers rejetés" styleClass="text-muted"/>
                <Label fx:id="kpiRejetesLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                <Label fx:id="tauxRejetLabel" text="Taux : 0%" style="-fx-font-size: 11px; -fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <!-- Charts Row -->
        <HBox spacing="18.0" prefHeight="320.0">
            <!-- Pie Chart Status Breakdown -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
                <Label text="Répartition des dossiers par statut" styleClass="title-medium"/>
                <PieChart fx:id="statusPieChart" legendSide="RIGHT" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Bar Chart Status Counts -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="card">
                <Label text="Volume par état de traitement" styleClass="title-medium"/>
                <BarChart fx:id="statusBarChart" legendVisible="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- Recent Activities Table -->
        <VBox spacing="12.0" styleClass="card">
            <Label text="Derniers dossiers traités" styleClass="title-medium"/>
            <TableView fx:id="recentTable" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colNumeroSuivi" text="N° Suivi" prefWidth="140.0"/>
                    <TableColumn fx:id="colCitoyen" text="Usager" prefWidth="180.0"/>
                    <TableColumn fx:id="colDemarche" text="Démarche" prefWidth="230.0"/>
                    <TableColumn fx:id="colService" text="Service" prefWidth="200.0"/>
                    <TableColumn fx:id="colDate" text="Date Dépôt" prefWidth="130.0"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="160.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
